# Copy this file to .env in the repo root and fill in your keys:
#   cp .env.example .env
# .env is gitignored, so your keys never get committed.

# Required for every notebook. Get a key at https://platform.claude.com/ (Settings > API keys).
ANTHROPIC_API_KEY="your_key_here"

# Only for the RAG notebooks. Get a key at https://www.voyageai.com/
VOYAGE_API_KEY="your_voyage_key_here"
